{
  "name": "staging-tengil-web",
  "version": "1.0.0",
  "description": "Staging test web page for Tengil Web Corporation — Qontak Webchat integration testing",
  "private": true,
  "scripts": {
    "start": "http-server . -p 3000 -o --cors",
    "dev": "live-server --port=3000 --open=index.html",
    "serve": "http-server . -p 3000 --cors",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "http-server": "^14.1.1",
    "live-server": "^1.2.2"
  }
}
